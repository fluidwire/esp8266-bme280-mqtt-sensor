// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
// Public test broker (no auth): "test.mosquitto.org", port 1883
// HiveMQ public: "broker.hivemq.com", port 1883
// Self-hosted: your broker host/IP
#define MQTT_HOST       "broker.hivemq.com"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "fluidwire-esp8266-bme280"
#define MQTT_USER       ""        // leave blank for anonymous brokers
#define MQTT_PASSWORD   ""
#define MQTT_TOPIC      "fluidwire/demo/bme280"
